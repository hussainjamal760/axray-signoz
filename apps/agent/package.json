{
  "name": "agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "test:fixture:setup": "cd test-fixture && npm install",
    "test:fixture:run": "ts-node src/index.ts --task \"Fix the failing tests. Read the test file to understand what is expected, then fix the source code.\" --dir ./test-fixture --verbose"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "latest",
    "typescript": "^5.9.3"
  }
}
