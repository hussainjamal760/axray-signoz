# =======================================================
# AXRAY SERVER ENVIRONMENT CONFIGURATION
# =======================================================
PORT=3001
NODE_ENV=development

# Session & Auth
SESSION_SECRET=axray_super_secret_session_key_change_in_prod
FRONTEND_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback
# Set to 'true' ONLY if serving over HTTPS with a real TLS certificate. 
# Leave 'false' for local Docker/judge testing over plain HTTP.
COOKIE_SECURE=false

# Groq LLM API Key (REQUIRED)
GROQ_API_KEY=gsk_your_groq_api_key_here

# -------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB)
# -------------------------------------------------------
# Mode A: Container Network (default when using docker compose up)
MONGO_URI=mongodb://mongo:27017/axray

# Mode B: Host / Local standalone Mongo (default for pnpm dev)
# MONGO_URI=mongodb://localhost:27017/axray

# Mode C: Remote MongoDB Atlas Cloud
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/axray

# -------------------------------------------------------
# SIGNOZ & OPENTELEMETRY TELEMETRY CONFIGURATION
# -------------------------------------------------------
# Mode A: Container Network (default when using docker compose up with Foundry)
OTLP_ENDPOINT=http://signoz-ingester-1:4318/v1/traces
SIGNOZ_INSTANCE_URL=http://signoz-mcp:8000
SIGNOZ_API_KEY=

# Mode B: Host Network (default for pnpm dev)
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
# SIGNOZ_INSTANCE_URL=http://localhost:8000